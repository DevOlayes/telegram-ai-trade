{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-ai-trade",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "ce85639597944ec397ce20a945952be1" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-ai-trade",
      "database_id": "6762afda-cd16-4f50-87f2-a3a8606047d9",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://telegram-ai-trade.godwin2000vic.workers.dev",
    "ASSET_HOST": "https://telegram-ai-trade.godwin2000vic.workers.dev",
    "TELEGRAM_BOT_USERNAME": "nexoraiaxbot",
    "ADMIN_USERNAME": "admin",
    "ENABLE_SCHEDULED_TICK": "true"
  },
  "previews": {
    "kv_namespaces": [
      { "binding": "MEDIA", "id": "01a2eca89e3942f5a375c43a87ca3e42" }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "telegram-ai-trade-preview",
        "database_id": "8b3d7383-2dd9-4beb-a631-5e5de3a62d98",
        "migrations_dir": "migrations"
      }
    ],
    "vars": {
      "APP_URL": "https://telegram-ai-trade-preview-telegram-ai-trade.godwin2000vic.workers.dev",
      "ASSET_HOST": "https://telegram-ai-trade-preview-telegram-ai-trade.godwin2000vic.workers.dev",
      "TELEGRAM_BOT_USERNAME": "nexoraiaxbot",
      "ADMIN_USERNAME": "admin",
      "ENABLE_SCHEDULED_TICK": "false"
    }
  }
}
