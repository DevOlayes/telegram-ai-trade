{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-ai-trade",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-ai-trade",
      "database_id": "6762afda-cd16-4f50-87f2-a3a8606047d9",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_URL": "https://povzibvrbzaqokzmdfon.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_a2waNRebUzA36a79jTX1Sg_VPnt6b6Q",
    "APP_URL": "https://telegram-ai-trade.godwin2000vic.workers.dev",
    "ASSET_HOST": "https://telegram-ai-trade.godwin2000vic.workers.dev",
    "TELEGRAM_BOT_USERNAME": "nexoraiaxbot",
    "ENABLE_SCHEDULED_TICK": "true"
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "telegram-ai-trade-preview",
        "database_id": "8b3d7383-2dd9-4beb-a631-5e5de3a62d98",
        "migrations_dir": "migrations"
      }
    ],
    "vars": {
      "SUPABASE_URL": "https://example.invalid",
      "SUPABASE_PUBLISHABLE_KEY": "preview-disabled",
      "APP_URL": "https://preview.invalid",
      "ASSET_HOST": "https://preview.invalid",
      "TELEGRAM_BOT_USERNAME": "nexoraiaxbot",
      "ENABLE_SCHEDULED_TICK": "false"
    }
  }
}
