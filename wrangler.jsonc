{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-ai-trade",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
